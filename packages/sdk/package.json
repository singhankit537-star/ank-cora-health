{
  "name": "@ank-cora/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for Cora Health APIs",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karambirsingh2/project-prep.git",
    "directory": "packages/sdk"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["cora", "health", "sdk", "api"],
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
