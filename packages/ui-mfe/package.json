{
  "name": "@ank-cora/ui-mfe",
  "version": "1.0.0",
  "description": "Shared UI component library (MFE package) for Cora Health apps",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "storybook"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:federation": "vite build --config vite.federation.config.ts",
    "dev:federation": "vite --config vite.federation.config.ts",
    "preview:federation": "vite preview --config vite.federation.config.ts",
    "dev": "tsc -p tsconfig.build.json --watch",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/addon-links": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^20.10.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@module-federation/vite": "^1.9.8",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint-plugin-storybook": "^0.11.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-redux": "^9.2.0",
    "react-router": "^7.2.0",
    "storybook": "8.6.18",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.3.3",
    "vite": "^6.0.0"
  }
}
