{
  "name": "@cora/web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "targets": {
    "dev": {
      "command": "vite",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "command": "tsc -b && vite build",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "typecheck": {
      "command": "tsc -b",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "command": "eslint .",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "test": {
      "command": "vitest run",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "test:coverage": {
      "command": "vitest run --coverage",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "preview": {
      "command": "vite preview",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "start": {
      "command": "vite preview",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": ["type:app", "scope:web"]
}
