# API base URL (proxied to backend in dev)
VITE_API_URL=/api

# Use mock data instead of live API routes
VITE_USE_MOCKS=true

# Standalone appointment host URL (e.g. http://localhost:3001 or https://appointment.coraphysicaltherapy.com)
# When set to an http(s) URL, Schedule/Book buttons open this instead of /appointment
VITE_APPOINTMENT_URL=

# Module Federation remote for @ank-cora/ui-mfe (optional)
# Example: http://localhost:3002/remoteEntry.js
VITE_UI_MFE_REMOTE=
